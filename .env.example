# ── PostgreSQL ───────────────────────────────────────────────
POSTGRES_HOST=plats-postgres
POSTGRES_PORT=5432
POSTGRES_DB=plats
POSTGRES_USER=plats
POSTGRES_PASSWORD=plats_secret_cambia_esto

# ── OpenWA ───────────────────────────────────────────────────
OPENWA_URL=http://plats-openwa:8083
OPENWA_API_KEY=plats_openwa_key_cambia_esto

# ── Backend PLATS Java ───────────────────────────────────────
# TEST:  http://plats-mock:8080/plats
# PROD:  http://172.28.0.150:8080/plats
PLATS_BASE_URL=http://plats-mock:8080/plats
PLATS_USER=admin
PLATS_PASS=admin

# ── Bot ──────────────────────────────────────────────────────
BOT_ADMIN_PHONE=51999999999
PHONES_AUTORIZADOS=

# ── Google Calendar / Meet ───────────────────────────────────
GOOGLE_CREDENTIALS_FILE=/app/credentials/google.json
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=

# ── RustDesk ─────────────────────────────────────────────────
RUSTDESK_API_URL=
RUSTDESK_API_KEY=

# ── Logs ─────────────────────────────────────────────────────
LOG_LEVEL=info
