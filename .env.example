# ──────────────────────────────────────────────────────
#  PLATS v3.0 — Variables de entorno
#  Copiar a .env y completar antes de docker compose up
# ──────────────────────────────────────────────────────

# URL del backend PLATS
# TEST  (Oracle Cloud): usa plats-mock:8080 automáticamente con --profile mock
# PROD  (red judicial): http://172.28.0.150:8080/plats
PLATS_BASE_URL=http://plats-mock:8080/plats

# Credenciales del usuario bot en el sistema PLATS
PLATS_USER=admin
PLATS_PASS=admin

# Teléfono del administrador del bot (con código de país, sin +)
BOT_ADMIN_PHONE=51999999999

# Teléfonos autorizados para agendar (coma separados, vacío = todos)
PHONES_AUTORIZADOS=

# Google Calendar / Meet (opcional — dejar vacío para deshabilitar)
GOOGLE_CREDENTIALS_FILE=/app/credentials/google.json
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=

# RustDesk (opcional — para conexión automática al penal)
RUSTDESK_API_URL=
RUSTDESK_API_KEY=

# Logs
LOG_LEVEL=info
